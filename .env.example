# =====================================================================
#  Családi Plex – konfiguráció
#
#  Másold le:  cp .env.example .env   majd töltsd ki az értékeket.
#  A .env fájl SOHA ne kerüljön Gitbe (a .gitignore kizárja).
#
#  Ugyanaz a kód és ugyanaz a Docker image fut a fejlesztői gépen és a
#  production szerveren – a két környezet KIZÁRÓLAG ebben a fájlban tér el.
# =====================================================================

# --- Alkalmazás -------------------------------------------------------
APP_ENV=production
# Kötelező! Generálás:  openssl rand -hex 32
APP_SECRET_KEY=change-me
# A böngészőben tárolt munkamenet élettartama órában (168 = 1 hét)
SESSION_TTL_HOURS=168
# HTTPS mögött állítsd true-ra (Secure cookie)
COOKIE_SECURE=false
LOG_LEVEL=INFO
# A webalkalmazás portja a HOST gépen
APP_PORT=8000

# --- Belépés (családtagok) -------------------------------------------
# A jelszót SOHA ne írd ide be nyíltan, csak a bcrypt hash-t!
# Hash generálása:
#   docker compose run --rm app python -m app.cli hash-password
# A parancs a .env-be másolható sort ad ki, a '$' jeleket már megduplázva -
# EZT MÁSOLD BE VÁLTOZATLANUL. Ha valahonnan máshonnan (pl. jelszókezelőből)
# illesztesz be nyers bcrypt hash-t, minden '$'-t duplázz meg ($$) kézzel,
# különben a docker compose a .env feldolgozásakor csonkítja a hash-t.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Opcionális további családtagok:  "nev:hash,nev2:hash2" (itt is dupla '$'-jelek!)
EXTRA_USERS=

# --- nCore ------------------------------------------------------------
NCORE_URL=https://ncore.pro
NCORE_USERNAME=
NCORE_PASSWORD=
# Keresési kategóriák (nCore "tipus" értékek, vesszővel elválasztva).
#   hd_hun    = Film HD/HU  (alapértelmezés)
#   hd        = Film HD (idegen nyelvű)
#   hdser_hun = Sorozat HD/HU
#   hdser     = Sorozat HD (idegen nyelvű)
# Több kategória esetén az eredmények összefésülve, seed szerint jönnek.
NCORE_CATEGORIES=hd_hun,hdser_hun
NCORE_TIMEOUT=20
NCORE_MAX_RESULTS=50

# --- qBittorrent ------------------------------------------------------
# A MÁR FUTÓ qBittorrent példány elérhetősége. Az alkalmazás nem indít
# és nem módosít qBittorrentet, csak vezérli a Web API-n keresztül.
#
#   közös Docker network esetén:  http://<konténer-neve>:8080
#   másik gépen / hoston:         http://192.168.1.10:8080
#
# NE használj localhost / 127.0.0.1 címet: a konténeren belül az saját magát
# jelentené, nem a qBittorrentet.
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=
# Opcionális qBittorrent kategória az innen indított torrenteknek (üres = nincs).
# FIGYELEM: ha a kategóriához mentési útvonal van rendelve a qBittorrentben,
# az felülírja az alapértelmezett letöltési könyvtárat.
QBITTORRENT_CATEGORY=
QBITTORRENT_TIMEOUT=20

# --- Média könyvtárak (csak tájékoztató) ------------------------------
# Az alkalmazás NEM fér hozzá a fájlrendszerhez; a letöltési helyet mindig
# a qBittorrenttől kérdezi le. Ezek az értékek csak dokumentációs célúak,
# hogy egy helyen legyen leírva, mit lát a qBittorrent és a Plex.
PLEX_DOWNLOAD_PATH=/media/downloads
PLEX_MOVIES_PATH=/media/movies

# --- Tárolás ----------------------------------------------------------
# A konténeren belüli útvonal (Docker named volume-ra mutat).
DATABASE_PATH=/data/app.db

# =====================================================================
#  Helyi kipróbálás valódi nCore / qBittorrent nélkül
#  ---------------------------------------------------------------
#  Indítás:  docker compose --profile mock up -d --build
#  és cseréld le a fenti két URL-t az alábbiakra:
#
#    NCORE_URL=http://mock:9080
#    QBITTORRENT_URL=http://mock:9080
#
#  Az nCore/qBittorrent felhasználónév és jelszó ilyenkor bármi lehet,
#  de nem maradhat üresen.
# =====================================================================
